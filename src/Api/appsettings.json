{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PixelRoute": "Data Source=pixelroute.db"
  },
  "Database": {
    "SeedDemoData": false
  },
  "Security": {
    "DispatcherApiKey": ""
  },
  "Notifications": {
    "Mode": "Ok",
    "MaxAttempts": 3,
    "BaseDelayMilliseconds": 200
  }
}
